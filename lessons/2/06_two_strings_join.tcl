# 06_two_strings_join.tcl — Week 2 Day 2: build one sentence from parts
# Run: make week2-06
#      tclsh lessons/2/06_two_strings_join.tcl

set firstName "Amy"
set lastName "Lee"
set hobby "drawing"

puts "Full name : $firstName $lastName"
puts "Sentence  : $firstName likes $hobby."
puts "Card line : Name=$firstName, Hobby=$hobby"
