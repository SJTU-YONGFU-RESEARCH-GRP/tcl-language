# 12_run_checklist.tcl — print the Week 1 checklist
# Run: tclsh lessons/1/12_run_checklist.tcl
# Note: use {curly braces} so [ ] is printed literally (Tcl would otherwise
# treat [ ... ] as a command). After you finish each item, edit [ ] to [x].

puts "Week 1 checklist"
puts "----------------"
puts {[ ] I can run tclsh}
puts {[ ] I can use puts}
puts {[ ] I can create a .tcl file}
puts {[ ] I can add # comments}
puts {[ ] I finished my self-intro card}
puts "----------------"
puts "When all boxes are done, Week 1 is complete. Great job!"
